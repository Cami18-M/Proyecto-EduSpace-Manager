# EDUSPACE MANAGER - Variables de entorno (ejemplo)
# Copia este archivo a .env y ajusta los valores para tu entorno local.
# NUNCA subas el archivo .env al repositorio.

# Puerto del servidor HTTP
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eduspace_manager

# Sincroniza el esquema automáticamente (solo true en desarrollo)
DB_SYNCHRONIZE=true
