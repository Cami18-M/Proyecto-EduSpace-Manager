# EDUSPACE MANAGER - Variables de entorno (ejemplo)
# Copia este archivo a .env y completa los valores para tu entorno local.
# NUNCA subas el archivo .env al repositorio (está incluido en .gitignore).

# Puerto del servidor HTTP
PORT=

# Conexión a MySQL
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Sincronización automática del esquema (solo true en desarrollo local)
DB_SYNCHRONIZE=
